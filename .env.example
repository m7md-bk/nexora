# PostgreSQL connection (any standards-compliant provider)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nexora?schema=public"

# Public deployment URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session and security secrets (use at least 32 random bytes in production)
AUTH_SECRET="replace-with-a-long-random-secret"

# Initial development seed administrator
SEED_ADMIN_EMAIL="admin@nexora.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional transactional email (password reset and verification)
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="Nexora <no-reply@example.com>"

# Payment provider adapter (manual is currently implemented)
PAYMENT_PROVIDER="manual"
PAYMENT_WEBHOOK_SECRET=""

# S3-compatible private object storage for secure uploads
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Optional analytics identifier
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
