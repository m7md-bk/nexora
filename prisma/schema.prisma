generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DRAFT
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  PAUSED
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethodType {
  MANUAL_BANK_TRANSFER
  CASH
  CARD
  GATEWAY
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  SUBSCRIPTION
  PAYMENT
  ORDER
  CONTENT
  SYSTEM
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  passwordHash          String
  name                  String
  phone                 String?
  avatarUrl             String?
  locale                String               @default("en")
  status                UserStatus           @default(PENDING_VERIFICATION)
  emailVerifiedAt       DateTime?
  roleId                 String
  role                   Role                 @relation(fields: [roleId], references: [id])
  customerProfile       CustomerProfile?
  sessions               Session[]
  passwordResetTokens   PasswordResetToken[]
  subscriptions         Subscription[]
  orders                 Order[]
  payments               Payment[]
  paymentMethods         PaymentMethod[]
  invoices               Invoice[]
  contentRequests        ContentRequest[]
  contentDeliveries      ContentDelivery[]
  customerServices       CustomerService[]
  notifications          Notification[]
  couponUsages           CouponUsage[]
  adminActivities        AdminActivityLog[]
  auditLogs              AuditLog[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  @@index([roleId, status])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model CustomerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String?
  businessType String?
  website      String?
  address      String?
  city         String?
  taxNumber    String?
  brandInfo    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Package {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String
  price          Decimal           @db.Decimal(12, 3)
  currency       String            @default("JOD")
  billingInterval BillingInterval  @default(MONTHLY)
  status         RecordStatus      @default(ACTIVE)
  isPopular      Boolean           @default(false)
  displayOrder   Int               @default(0)
  ctaText        String            @default("Get started")
  serviceLimits  Json?
  features       PackageFeature[]
  subscriptions  Subscription[]
  orderItems     OrderItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  @@index([status, displayOrder])
}

model PackageFeature {
  id           String   @id @default(cuid())
  packageId    String
  package      Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  limit        Int?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  @@index([packageId, displayOrder])
}

model Service {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String
  icon             String?
  category         String
  status           RecordStatus      @default(ACTIVE)
  displayOrder     Int               @default(0)
  price            Decimal?          @db.Decimal(12, 3)
  currency         String            @default("JOD")
  customerServices CustomerService[]
  orderItems       OrderItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  @@index([status, displayOrder])
}

model CustomerService {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  serviceId      String
  subscriptionId String?
  service        Service      @relation(fields: [serviceId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  status         RecordStatus @default(ACTIVE)
  usage          Int          @default(0)
  limit          Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([userId, serviceId, subscriptionId])
  @@index([userId, status])
}

model Subscription {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  packageId      String
  package        Package            @relation(fields: [packageId], references: [id])
  status         SubscriptionStatus @default(PENDING)
  amount         Decimal            @db.Decimal(12, 3)
  currency       String             @default("JOD")
  billingInterval BillingInterval
  startsAt       DateTime
  renewsAt       DateTime?
  expiresAt      DateTime?
  cancelledAt    DateTime?
  items          SubscriptionItem[]
  customerServices CustomerService[]
  orders         Order[]
  invoices       Invoice[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  @@index([userId, status])
  @@index([status, renewsAt])
}

model SubscriptionItem {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  name           String
  quantity       Int          @default(1)
  unitAmount     Decimal      @db.Decimal(12, 3)
  metadata       Json?
  createdAt      DateTime     @default(now())
  @@index([subscriptionId])
}

model OrderCounter {
  year      Int      @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id])
  amount        Decimal       @db.Decimal(12, 3)
  discountAmount Decimal      @default(0) @db.Decimal(12, 3)
  currency      String        @default("JOD")
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  couponCode    String?
  items         OrderItem[]
  payments      Payment[]
  invoice       Invoice?
  couponUsages  CouponUsage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([userId, status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packageId   String?
  package     Package? @relation(fields: [packageId], references: [id])
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  name        String
  quantity    Int      @default(1)
  unitAmount  Decimal  @db.Decimal(12, 3)
  totalAmount Decimal  @db.Decimal(12, 3)
  @@index([orderId])
}

model PaymentMethod {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  type      PaymentMethodType
  label     String
  details   Json?
  isDefault Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  @@index([userId])
}

model Payment {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id])
  orderId              String?
  order                Order?        @relation(fields: [orderId], references: [id])
  amount               Decimal       @db.Decimal(12, 3)
  currency             String        @default("JOD")
  status               PaymentStatus @default(PENDING)
  method               PaymentMethodType
  provider             String        @default("manual")
  transactionReference String?
  proofUrl             String?
  customerNote         String?
  adminNote            String?
  paidAt               DateTime?
  reviewedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  @@index([userId, status])
  @@index([status, createdAt])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  orderId        String?       @unique
  order          Order?        @relation(fields: [orderId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subtotal       Decimal       @db.Decimal(12, 3)
  discount       Decimal       @default(0) @db.Decimal(12, 3)
  tax            Decimal       @default(0) @db.Decimal(12, 3)
  total          Decimal       @db.Decimal(12, 3)
  currency       String        @default("JOD")
  status         PaymentStatus @default(PENDING)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  @@index([userId, status])
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(12, 3)
  minimumAmount   Decimal?     @db.Decimal(12, 3)
  maximumDiscount Decimal?     @db.Decimal(12, 3)
  usageLimit      Int?
  perUserLimit    Int          @default(1)
  startsAt        DateTime?
  expiresAt       DateTime?
  isActive        Boolean      @default(true)
  usages          CouponUsage[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@index([isActive, startsAt, expiresAt])
}

model CouponUsage {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  discount   Decimal  @db.Decimal(12, 3)
  createdAt  DateTime @default(now())
  @@index([couponId, userId])
  @@unique([couponId, orderId])
}

model ContentRequest {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  title          String
  platform       String
  contentType    String
  description    String
  targetAudience String?
  brandInfo      String?
  desiredTone    String?
  deadline       DateTime?
  attachmentUrls String[]
  notes          String?
  status         RequestStatus @default(PENDING)
  deliveries     ContentDelivery[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([userId, status])
  @@index([status, deadline])
}

model ContentDelivery {
  id               String         @id @default(cuid())
  contentRequestId String
  contentRequest   ContentRequest @relation(fields: [contentRequestId], references: [id], onDelete: Cascade)
  title            String
  message          String?
  fileUrls         String[]
  externalLinks    String[]
  deliveredById    String
  deliveredBy      User           @relation(fields: [deliveredById], references: [id])
  createdAt        DateTime       @default(now())
  @@index([contentRequestId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  @@index([userId, readAt, createdAt])
}

model FAQ {
  id           String       @id @default(cuid())
  questionEn   String
  answerEn     String
  questionAr   String
  answerAr     String
  status       RecordStatus @default(ACTIVE)
  displayOrder Int          @default(0)
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  @@index([status, displayOrder])
}

model Testimonial {
  id           String            @id @default(cuid())
  customerName String
  businessName String?
  avatarUrl    String?
  rating       Int
  commentEn    String
  commentAr    String?
  status       TestimonialStatus @default(PENDING)
  isActive     Boolean           @default(false)
  displayOrder Int               @default(0)
  isDemo       Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  @@index([status, isActive, displayOrder])
}

model HeroSection {
  id          String       @id @default(cuid())
  titleEn     String
  titleAr     String
  subtitleEn  String
  subtitleAr  String
  ctaTextEn   String
  ctaTextAr   String
  ctaUrl      String
  imageUrl    String?
  status      RecordStatus @default(ACTIVE)
  updatedAt   DateTime     @updatedAt
}

model WebsiteSection {
  id           String       @id @default(cuid())
  key          String       @unique
  titleEn      String?
  titleAr      String?
  contentEn    Json?
  contentAr    Json?
  isEnabled    Boolean      @default(true)
  displayOrder Int          @default(0)
  status       RecordStatus @default(ACTIVE)
  updatedAt    DateTime     @updatedAt
  @@index([isEnabled, displayOrder])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  @@index([isPublic])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([status, createdAt])
}

model AdminActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([entity, entityId])
}
